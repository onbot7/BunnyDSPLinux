#!/usr/bin/env bash
set -e

PRG="$0"
while [ -h "$PRG" ]; do
    ls=$(ls -ld "$PRG")
    link=$(expr "$ls" : '.*-> \(.*\)$')
    if expr "$link" : '/.*' > /dev/null; then
        PRG="$link"
    else
        PRG="$(dirname "$PRG")/$link"
    fi
done
PROJECT_DIR="$(cd "$(dirname "$PRG")" && pwd)"

if [ "$1" = "gui" ]; then
    shift
    if [ -x "$PROJECT_DIR/KT0210-gui" ]; then
        exec "$PROJECT_DIR/KT0210-gui" "$@"
    elif [ -x "$PROJECT_DIR/kt0210-gui" ]; then
        exec "$PROJECT_DIR/kt0210-gui" "$@"
    elif [ -x "$PROJECT_DIR/tanchjim-gui" ]; then
        exec "$PROJECT_DIR/tanchjim-gui" "$@"
    fi
fi

exec python3 "$PROJECT_DIR/tanchjim_bunny.py" "$@"
